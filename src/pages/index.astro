---
import BaseLayout from "../layouts/BaseLayout.astro";

// Put a photo at public/images/hero.jpg, then set this to "/images/hero.jpg".
// While it's empty, a soft placeholder shows instead.
const heroImage = "";
---

<BaseLayout title="a little unsaid. — books, feelings, and the things we don't always say">
  <main>
    <section class="container hero">
      <div class="hero-text">
        <p class="label">A quiet place for curious hearts</p>
        <h1>Books, feelings, and the things we <em>don't always</em> say.</h1>
        <p class="intro">
          A personal corner of the internet for reading, reflecting, and making
          sense of the in-between.
        </p>
        <a href="/read" class="btn">Explore the journey →</a>
      </div>

      <div class="hero-image">
        {heroImage ? <img src={heroImage} alt="" /> : <div class="placeholder"></div>}
        <p class="handwritten sticky">same stories, different versions of me.</p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-5);
    align-items: center;
    padding-block: var(--space-5);
  }
  .hero-text h1 {
    max-width: 11em; /* narrows the headline so it breaks nicely */
    margin-block: var(--space-2) var(--space-3);
  }
  .intro {
    max-width: 26em;
    color: var(--gray);
    margin-bottom: var(--space-4);
  }
  .hero-image {
    position: relative;
    aspect-ratio: 4 / 4.2;
  }
  .hero-image img,
  .placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    background: linear-gradient(160deg, var(--line), var(--sage));
    opacity: 0.55;
  }
  /* the little torn-note on the corner of the photo */
  .sticky {
    position: absolute;
    right: -0.8rem;
    bottom: 2rem;
    max-width: 9rem;
    margin: 0;
    padding: 1rem 1.2rem;
    background: #ece5d8;
    color: var(--ink);
    transform: rotate(-4deg);
    box-shadow: 1px 3px 10px rgba(36, 33, 30, 0.18);
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding-block: var(--space-4);
    }
    .sticky {
      right: 0.5rem;
    }
  }
</style>