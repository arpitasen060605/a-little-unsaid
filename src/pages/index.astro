---
// 1. FRONTMATTER (between the --- fences)
// This is JavaScript that runs when the site is built, not in the visitor's browser.
const siteName = "a little unsaid.";
const tagline = "books, feelings, and the things we don't always say.";
---

<!-- 2. TEMPLATE: HTML, plus {curly braces} to insert variables -->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{siteName}</title>
  </head>
  <body>
    <main>
      <h1>{siteName}</h1>
      <p>{tagline}</p>
    </main>
  </body>
</html>

<!-- 3. STYLES: CSS that only applies to this file -->
<style>
  body {
    background: #F5F1E9; /* Paper */
    color: #24211E;      /* Ink */
    font-family: Georgia, serif;
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    text-align: center;
  }
  h1 {
    font-size: 3rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
  }
  p {
    color: #817B73; /* Warm Gray */
  }
</style>