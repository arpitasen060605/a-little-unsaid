---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EssayCard from "../components/EssayCard.astro";
import BookCard from "../components/BookCard.astro";
import { readingTime } from "../utils/readingTime";

const heroImage = "";

// Essays, newest first
const essays = (await getCollection("essays")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = essays.find((e) => e.data.featured) ?? essays[0];
const latest = essays.slice(0, 3);

// Books (first five for the preview)
const books = (await getCollection("books")).slice(0, 5);
const statusLabel = {
  "currently-reading": "Currently reading",
  "finished": "Finished",
  "want-to-read": "Want to read",
};

// Margins, newest first
const margins = (await getCollection("notes"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="a little unsaid. — books, feelings, and the things we don't always say">
  <main>

    <!-- HERO -->
    <section class="container hero">
      <div class="hero-text">
        <p class="label">A quiet place for curious hearts</p>
        <h1>Books, feelings, and the things we <em>don't always</em> say.</h1>
        <p class="intro">
          A personal corner of the internet for reading, reflecting, and making
          sense of the in-between.
        </p>
        <a href="/read" class="btn">Explore the journey →</a>
      </div>

      <div class="hero-image">
        {heroImage ? <img src={heroImage} alt="" /> : <div class="placeholder"></div>}
        <p class="handwritten sticky">same stories, different versions of me.</p>
      </div>
    </section>

        <!-- FEATURED ESSAY -->
    {featured && (
      <section class="container section featured">
        <div class="featured-image">
          <div class="placeholder"></div>
        </div>
        <div class="featured-text">
          <p class="label">Featured essay · {readingTime(featured.body)} min read</p>
          <h2>{featured.data.title}</h2>
          <p class="blurb">{featured.data.description}</p>
          <a href={`/essays/${featured.id}`} class="link-arrow">Read</a>
        </div>
      </section>
    )}

    <!-- LATEST FROM THE JOURNAL -->
    <section class="container section">
      <div class="section-head">
        <h2>Latest from the journal</h2>
        <a href="/read" class="link-arrow label">View all</a>
      </div>
           <div class="grid-3">
        {latest.map((e) => (
          <EssayCard
            category={e.data.category}
            title={e.data.title}
            readTime={readingTime(e.body)}
            href={`/essays/${e.id}`}
          />
        ))}
      </div>
    </section>

    <!-- BOOKSHELF PREVIEW -->
    <section class="container section">
      <div class="section-head">
        <h2>My bookshelf</h2>
        <a href="/bookshelf" class="link-arrow label">View all</a>
      </div>
           <div class="shelf">
        {books.map((b) => (
          <BookCard
            title={b.data.title}
            author={b.data.author}
            status={statusLabel[b.data.status]}
            color={b.data.color}
            note={b.data.note}
          />
        ))}
      </div>
    </section>

    <!-- FROM THE MARGINS -->
    <section class="container section">
      <div class="section-head">
        <h2>From the margins</h2>
        <a href="/margins" class="link-arrow label">View all</a>
      </div>
            <ul class="margin-list">
        {margins.map((m) => (
          <li>
            <span class="label">{m.data.number}</span>
            <p>{m.data.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- A LITTLE LETTER -->
    <section class="container section">
      <a href="#" class="letter">
        <p class="label">A little letter · September</p>
        <h2>On books I almost abandoned, people I still think about, and the strange comfort of starting over.</h2>
        <span class="link-arrow">Read</span>
      </a>
    </section>

  </main>
</BaseLayout>

<style>
  /* shared spacing between homepage sections */
  .section {
    margin-top: var(--space-6);
  }

  /* ---------- Hero (unchanged) ---------- */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-5);
    align-items: center;
    padding-block: var(--space-5);
  }
  .hero-text h1 {
    max-width: 11em;
    margin-block: var(--space-2) var(--space-3);
  }
  .intro {
    max-width: 26em;
    color: var(--gray);
    margin-bottom: var(--space-4);
  }
  .hero-image {
    position: relative;
    aspect-ratio: 4 / 4.2;
  }
  .hero-image img,
  .placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    background: linear-gradient(160deg, var(--line), var(--sage));
    opacity: 0.55;
  }
  .sticky {
    position: absolute;
    right: -0.8rem;
    bottom: 2rem;
    max-width: 9rem;
    margin: 0;
    padding: 1rem 1.2rem;
    background: #ece5d8;
    color: var(--ink);
    transform: rotate(-4deg);
    box-shadow: 1px 3px 10px rgba(36, 33, 30, 0.18);
  }

  /* ---------- Featured essay ---------- */
  .featured {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    align-items: center;
  }
  .featured-image {
    aspect-ratio: 4 / 3;
  }
  .featured-text h2 {
    margin-block: var(--space-1) var(--space-2);
  }
  .blurb {
    color: var(--gray);
    max-width: 26em;
    margin-bottom: var(--space-3);
  }

  /* ---------- Bookshelf preview ---------- */
  .shelf {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-3);
  }

  /* ---------- Margins list ---------- */
  .margin-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .margin-list li {
    display: grid;
    grid-template-columns: 4rem 1fr;
    align-items: baseline;
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--line);
  }
  .margin-list p {
    margin: 0;
    font-size: var(--text-lg);
    font-style: italic;
  }

  /* ---------- Little letter ---------- */
  .letter {
    display: block;
    background: #3a2f2a;
    color: var(--paper);
    padding: var(--space-5) var(--space-4);
    background-image: none;
  }
  .letter .label {
    color: #c9bfae;
  }
  .letter h2 {
    max-width: 22em;
    margin-block: var(--space-2) var(--space-3);
  }

  /* ---------- Tablet + phone ---------- */
  @media (max-width: 960px) {
    .shelf {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding-block: var(--space-4);
    }
    .sticky {
      right: 0.5rem;
    }
    .featured {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .shelf {
      grid-template-columns: repeat(2, 1fr);
    }
    .margin-list li {
      grid-template-columns: 3rem 1fr;
    }
    .letter {
      padding: var(--space-4) var(--space-3);
    }
  }
</style>