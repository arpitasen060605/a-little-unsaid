---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";

export async function getStaticPaths() {
  // oldest first, so the neighbours in the list are the neighbours in time
  const essays = (await getCollection("essays")).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
  );
  const allBooks = await getCollection("books");

  return essays.map((entry, i) => ({
    params: { id: entry.id },
    props: {
      entry,
      older: essays[i - 1] ?? null,
      newer: essays[i + 1] ?? null,
      books: allBooks.filter((b) => entry.data.relatedBooks.includes(b.id)),
      // two other essays, same category first
      more: essays
        .filter((e) => e.id !== entry.id)
        .sort(
          (a, b) =>
            Number(b.data.category === entry.data.category) -
            Number(a.data.category === entry.data.category)
        )
        .slice(0, 2),
    },
  }));
}

const { entry, older, newer, books, more } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout entry={entry} older={older} newer={newer} books={books} more={more}>
  <Content />
</ArticleLayout>